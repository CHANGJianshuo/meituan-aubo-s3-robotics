<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mtc_manipulation</name>
  <version>0.1.0</version>
  <description>
    单块电池抓放状态机（第二层 PickPlace FSM）。包含纯 Python FSM 核心（不依赖 rclpy）、
    V1/V2 工具策略、Fake 端口，以及 rclpy Action Server 外壳。
    设计依据：docs/architecture/AUBO_S3_ROS2_状态机与接口技术设计_v0.1.md §3.2/§5/§6.4/§7。
  </description>
  <maintainer email="maintainer@example.invalid">meituan_challenge_ws maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>mtc_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
