<?xml version="1.0"?>
<package format="3">
  <name>mtc_simulation</name><version>0.1.0</version>
  <description>V1 passive hook Gazebo Harmonic simulation and measured acceptance.</description>
  <maintainer email="maintainers@example.com">meituan_challenge_ws contributors</maintainer>
